# Gmail API Credentials File
GMAIL_CREDENTIALS=credentials.json

# OAuth Token File (Auto-generated)
GMAIL_TOKEN=token.json

# Rate Limiting
# Delay between emails in seconds
RATE_LIMIT_DELAY=2

# Retry Configuration
MAX_RETRIES=3
BACKOFF_FACTOR=2

# Application Mode
# Options: send, draft, dry-run
DEFAULT_MODE=dry-run
